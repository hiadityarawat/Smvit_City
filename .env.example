NODE_ENV=development
POSTGRES_DB=socialverse
POSTGRES_USER=socialverse
POSTGRES_PASSWORD=change-me-in-production
DATABASE_URL=postgresql://socialverse:change-me-in-production@localhost:5432/socialverse?schema=public
SERVER_PORT=4000
CLIENT_ORIGIN=http://localhost:5173
VITE_API_URL=http://localhost:4000/api
VITE_SOCKET_URL=http://localhost:4000
ACCESS_TOKEN_SECRET=replace-with-at-least-32-random-characters
REFRESH_TOKEN_SECRET=replace-with-another-32-random-characters
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
PASSWORD_RESET_TTL_MINUTES=30
PASSWORD_RESET_URL=http://localhost:5173/reset-password
COOKIE_SECURE=false
LOG_LEVEL=info
API_PUBLIC_URL=http://localhost:4000
OAUTH_STATE_SECRET=replace-with-at-least-32-random-characters
INTEGRATION_TOKEN_SECRET=replace-with-another-32-random-characters

# Optional official social integrations. Leave blank to keep a provider disabled.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Optional transactional password-reset email (Resend REST API).
RESEND_API_KEY=
EMAIL_FROM=
